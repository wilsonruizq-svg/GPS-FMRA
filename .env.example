# Copia este archivo a `.env` (gitignored) y completa los valores.
# Nunca pegues secretos reales en el repositorio.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Acepta sb_publishable_... (SDKs recientes vía publishableKey) o JWT anon (eyJ...).
# Si Auth falla con publishable, usa Project Settings → API → anon public JWT.
SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY_OR_eyJ_JWT

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
