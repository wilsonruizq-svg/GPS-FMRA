# Copia este archivo a `.env` (gitignored) y completa los valores.
# Nunca pegues secretos reales en el repositorio.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Acepta sb_publishable_... (SDKs recientes vía publishableKey) o JWT anon (eyJ...).
# Solo cambia a JWT anon si ves 401/invalid API key — NO para Connection reset.
SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY_OR_eyJ_JWT

# --- Mapa (MapLibre) — guía: docs/MAPLIBRE_ES.md ---
# Por defecto (sin estas variables) se usa OpenFreeMap Liberty, sin API key.
# Smoke test alternativo (demotiles MapLibre, sin calles detalladas):
# MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
#
# Opcional — MapTiler Free (cuenta gratis, sin tarjeta): https://cloud.maptiler.com/
# MAPTILER_API_KEY=your_maptiler_api_key_here
# Si hay MAPTILER_API_KEY y no hay MAP_STYLE_URL, se usa Streets v2 de MapTiler.
# MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY

MAP_STYLE_URL=
MAPTILER_API_KEY=

# Google Maps pausado (billing Cloud). No hace falta para el mapa actual.
# Guía antigua: docs/GOOGLE_MAPS_ES.md
GOOGLE_MAPS_API_KEY=
