# Copia este archivo a `.env` (gitignored) y completa los valores.
# Nunca pegues secretos reales en el repositorio.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Acepta sb_publishable_... (SDKs recientes vía publishableKey) o JWT anon (eyJ...).
# Solo cambia a JWT anon si ves 401/invalid API key — NO para Connection reset.
SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY_OR_eyJ_JWT

# Misma clave también en android/local.properties (GOOGLE_MAPS_API_KEY=…).
# Guía: docs/GOOGLE_MAPS_ES.md
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
